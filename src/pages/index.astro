---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExplodedView from '../components/ExplodedView.astro';
const projects = (await getCollection('projects')).sort((a, b) => b.data.sort - a.data.sort);
const sides = Array.from({ length: 6 }, (_, i) => ({ name: `[Side ${i + 1}]`, spec: '[One line: what this side brings]' }));
const experience = [
  { title: 'Research Attachment', date: 'May 2026 to Jan 2027', org: 'A*STAR SIMTech, Singapore', desc: 'Inkjet and binder jet printing: process tuning, sample characterisation, CAD fixes for printer hardware.' },
  { title: 'Manufacturing Engineering Intern', date: 'Feb 2023 to Jul 2023', org: 'SMC Corporation Vietnam', desc: 'Concept design of a CNC coolant-tank cleaning machine in Autodesk Inventor.' },
  { title: 'Technical Artist and XR Developer', date: 'Oct 2022 to 2024', org: 'ARIS, Hanoi', desc: 'Spark AR and Unity experiences, 3D assets, rigging and animation.' },
];
const education = [
  { title: 'MSc Engineering Design and Innovation', date: 'Expected Jan 2027', org: 'National University of Singapore' },
  { title: 'BSc Mechanical Engineering, mechatronics', date: '2025', org: 'VinUniversity, Vietnam' },
  { title: 'Exchange', date: '2023 to 2024', org: 'POSTECH, South Korea' },
];
const skills = [
  ['CAD', 'SolidWorks, Inventor, Fusion 360'],
  ['Simulation', 'ANSYS FEA, ANSYS Fluent CFD, MATLAB'],
  ['Programming', 'Python, C#, C++'],
  ['Hardware', 'Arduino, ESP32, sensors, actuators'],
  ['XR and media', 'Unity, Spark AR, Blender, Figma, DaVinci Resolve'],
  ['Languages', 'Vietnamese (native), English (professional), Mandarin (beginner)'],
];
---
<Base title="Nguyen Duy Quang | Portfolio" home>
  <main>
    <div class="hero-band">
      <div class="wrap">
        <div class="hero-row">
          <section id="home" class="panel-hero cut" aria-labelledby="h-home">
            <div class="kick">
              <svg width="32" height="32" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7V3h4M17 3h4v4M21 17v4h-4M7 21H3v-4"/></g><rect x="9" y="9" width="6" height="6" fill="currentColor"/></svg>
              <span class="neon">NDQ/001</span>
              <span>Mechanical · Mechatronics · Design</span>
              <span class="kline" aria-hidden="true"></span>
            </div>
            <h1 id="h-home" class="stencil rgb">Nguyen Duy Quang</h1>
            <p class="lede">[Positioning line: one sentence on what you build and for whom]</p>
            <div class="btns">
              <a class="ndq-btn primary" href="#work">View work</a>
              <a class="ndq-btn secondary" href="#">Download CV</a>
            </div>
          </section>
        </div>
      </div>
    </div>
    <div class="wrap">
      <section id="work" class="panel cut" aria-labelledby="work-h">
        <div class="head"><h2 id="work-h" class="stencil">Work</h2></div>
        <div class="grid">
          {projects.map((p) => <ProjectCard slug={p.id} {...p.data} />)}
        </div>
      </section>
      <section id="sides" class="panel cut col" aria-labelledby="sides-h">
        <h2 id="sides-h" class="stencil">Exploded view</h2>
        <p class="lead-p">[One plain sentence: the parts that make up how you work, beyond the job title.]</p>
        <ExplodedView parts={sides} />
      </section>
      <section id="about" class="panel cut" aria-labelledby="about-h">
        <div class="full col">
          <h2 id="about-h" class="stencil">About</h2>
          <p class="lead-p narrow">[Two or three plain sentences: what you build, how you work, what you are looking for next.]</p>
        </div>
        <div class="full">
          <h3>Experience</h3>
          <ul class="list">
            {experience.map((e) => (
              <li><div class="row"><span class="ti">{e.title}</span><span class="dt">{e.date}</span></div><div class="org">{e.org}</div><p class="ds">{e.desc}</p></li>
            ))}
          </ul>
        </div>
        <div class="half">
          <h3>Education</h3>
          <ul class="list">
            {education.map((e) => (
              <li><div class="row"><span class="ti">{e.title}</span><span class="dt">{e.date}</span></div><div class="org">{e.org}</div></li>
            ))}
          </ul>
        </div>
        <div class="half">
          <h3>Skills</h3>
          <dl class="skills">
            {skills.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
        </div>
      </section>
    </div>
  </main>
  <div class="wrap">
    <footer id="contact" class="panel cut" aria-labelledby="contact-h">
      <div class="col tight">
        <h2 id="contact-h" class="stencil">Contact</h2>
        <p class="lead-p">[One line: what you are open to, and how to reach you]</p>
      </div>
      <ul class="links">
        {['[Email]', 'LinkedIn', 'GitHub'].map((l) => <li><a class="ndq-btn secondary btn-s" href="#">{l}<span aria-hidden="true">↗</span></a></li>)}
      </ul>
    </footer>
  </div>
  <div aria-hidden="true" class="spacer"></div>
</Base>
<style>
  .hero-band{position:relative}
  .hero-row{display:flex;flex-wrap:wrap;gap:32px;align-items:flex-end;padding:120px 0 64px}
  #home{scroll-margin-top:90px;flex:0 1 auto;max-width:820px;display:flex;flex-direction:column;gap:16px;background:color-mix(in srgb,var(--bg) 45%,transparent);-webkit-backdrop-filter:blur(1px);backdrop-filter:blur(1px);--bw:1px;--bc:var(--panel-border);--cut:28px;padding:40px}
  .kick{display:flex;flex-wrap:wrap;align-items:center;gap:14px;font-family:var(--font-mono);font-size:16px;letter-spacing:.26em;text-transform:uppercase;color:var(--accent)}
  .neon{background:var(--accent);color:var(--on-accent);padding:4px 8px 4px 11px}
  h1{margin:0;font-size:clamp(36px,4.4vw,64px);line-height:1;font-weight:700}
  .lede{margin:0;font-size:20px;line-height:30px;max-width:520px}
  .btns{display:flex;flex-wrap:wrap;gap:16px;margin-top:8px}
  .panel{background:color-mix(in srgb,var(--bg) 45%,transparent);-webkit-backdrop-filter:blur(1px);backdrop-filter:blur(1px);--bw:1px;--bc:var(--panel-border);--cut:28px;padding:40px;margin:32px 0;scroll-margin-top:90px}
  .head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:32px}
  h2{margin:0;font-size:48px;line-height:1.05;font-weight:700}
  .grid{display:flex;flex-wrap:wrap;gap:24px}
  .col{display:flex;flex-direction:column;gap:16px}
  .lead-p{margin:0;font-size:17px;line-height:27px;max-width:680px}
  .narrow{max-width:560px}
  #about{display:flex;flex-wrap:wrap;gap:40px 48px}
  .full{flex:1 1 100%}
  .half{flex:1 1 380px}
  h3{margin:0 0 12px;font-family:var(--font-mono);font-size:14px;font-weight:400;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
  .list,.links{list-style:none;margin:0;padding:0}
  .list li{padding:12px 0;border-top:1px solid var(--panel-border)}
  .row{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 16px}
  .ti{font-size:17px;font-weight:600}
  .dt{font-family:var(--font-mono);font-size:14px;color:var(--text-muted)}
  .org{font-family:var(--font-mono);font-size:14px}
  .ds{margin:4px 0 0;font-size:15px;line-height:22px;color:var(--text-muted)}
  .skills{margin:0}
  .skills div{display:flex;gap:16px;padding:10px 0;border-top:1px solid var(--panel-border)}
  .skills dt{flex:0 0 120px;font-family:var(--font-mono);font-size:14px;color:var(--text-muted)}
  .skills dd{margin:0;font-size:15px;line-height:22px}
  #contact{margin:32px 0 0;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:24px 48px}
  .tight{gap:8px}
  .links{display:flex;flex-wrap:wrap;gap:12px}
  .btn-s{padding:0 20px;gap:10px}
  .spacer{height:220px}
</style>
