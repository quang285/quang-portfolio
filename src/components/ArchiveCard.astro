---
interface Props {
  type: string;
  date: string;
  title: string;
  note: string;
  source: string;
  thumb?: string;
  entry?: string;
}
const { type, date, title, note, source, thumb, entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const label = type.charAt(0).toUpperCase() + type.slice(1);
const href = entry ? `${base}archive/${entry}/` : undefined;
---
<div class="ndq-cardwrap arc-item" data-type={type}>
  <article class="ndq-card arc-card cut">
    {thumb
      ? <img class="img cut" src={`${base}${thumb.replace(/^\//, '')}`} alt="" loading="lazy" />
      : <div class="img cut" role="img" aria-label="Placeholder: thumbnail">[Thumbnail]</div>}
    <div class="k">{label} · {date}</div>
    <h3 class="t">{href ? <a href={href}>{title}</a> : title}</h3>
    <p class="n">{note}</p>
    <div class="s">{source}</div>
  </article>
</div>
<style>
  .arc-card{gap:6px}
  .arc-card .img{margin-bottom:10px;object-fit:cover;width:100%}
  .k{font-family:var(--font-mono);font-size:14px;color:var(--accent)}
  .arc-card .t{font-size:20px;line-height:26px}
  .n{margin:0;font-size:15px;line-height:22px}
  .s{font-family:var(--font-mono);font-size:13px;color:var(--text-muted);margin-top:4px}
</style>
