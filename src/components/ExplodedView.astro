---
// Six stacked plates, numbered to match the parts table. Hover linking is pure CSS (global.css, #sides:has()).
interface Part { name: string; spec: string; }
interface Props { parts: Part[]; }
const { parts } = Astro.props;

// Front-left x, front-right x, front top y; then leader start and balloon centre.
const geo = [
  [197.5, 326.7, 81, 315, 90, 518, 74],
  [166.7, 311.9, 154, 300, 163, 495, 150],
  [133.4, 294.6, 235, 283, 244, 469, 226],
  [103.5, 280.7, 305, 269, 314, 448, 302],
  [70.8, 264.0, 384, 252, 393, 423, 378],
  [40.3, 249.5, 456, 238, 465, 400, 454],
];
const DX = 30.8, DY = 22, H = 18;
const pts = (p: number[][]) => p.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const nn = (i: number) => String(i + 1).padStart(2, '0');
---
<div class="xv">
  <div class="fig">
    <svg viewBox="0 0 560 520" width="100%" role="img" aria-label="Exploded view drawing of six stacked parts, each numbered to match the parts list">
      <line class="axis" x1="290" y1="30" x2="140" y2="510" stroke-dasharray="20 5 3 5" />
      {geo.map(([l, r, y, sx, sy, bx, by], i) => (
        <g class={`ndq-xp xp xp${nn(i)}`}>
          <g>
            <polygon points={pts([[l, y], [r, y], [r, y + H], [l, y + H]])} />
            <polygon points={pts([[r, y], [r + DX, y - DY], [r + DX, y - DY + H], [r, y + H]])} />
            <polygon points={pts([[l, y], [l + DX, y - DY], [r + DX, y - DY], [r, y]])} />
          </g>
          <line class="lead" x1={sx} y1={sy} x2={bx - 16} y2={by} />
          <circle cx={sx} cy={sy} r="2.5" class="dot" />
          <circle cx={bx} cy={by} r="16" class="ball" />
          <text x={bx} y={by + 5} text-anchor="middle">{i + 1}</text>
        </g>
      ))}
    </svg>
  </div>
  <table class="ndq-spec">
    <thead><tr><th scope="col" class="no">No.</th><th scope="col">Part</th><th scope="col">Spec</th></tr></thead>
    <tbody>
      {parts.map((p, i) => (
        <tr class={`xr xr${nn(i)}`}><td class="n">{nn(i)}</td><td class="p">{p.name}</td><td class="s">{p.spec}</td></tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  .xv{display:flex;flex-wrap:wrap;gap:24px 32px;align-items:center;margin-top:16px}
  .fig{flex:1 1 360px;max-width:520px}
  svg{display:block;max-width:560px}
  .axis{stroke:var(--holo);stroke-opacity:.6}
  .dot{fill:var(--holo)}
  .ndq-spec{flex:1 1 360px;width:auto}
  .no{width:56px}
  .p{font-weight:500;white-space:nowrap}
  .s{color:var(--text-muted)}
</style>
