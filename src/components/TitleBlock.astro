---
// Project hero band: breadcrumb, kicker, title, result line, facts grid and hero figure.
interface Fact { k: string; v: string; led?: boolean; }
interface Props { prj: string; kicker: string; title: string; result: string; facts: Fact[]; active?: boolean; }
const { prj, kicker, title, result, facts, active = false } = Astro.props;
---
<div class="band">
  <header class="tb cut">
    <nav aria-label="Breadcrumb" class="bc">
      <a class="crumb" href={`${import.meta.env.BASE_URL}#work`}>← Work</a>
      <span aria-hidden="true">/</span>
      <span>{prj}</span>
    </nav>
    <div class="kick">
      <svg width="32" height="32" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7V3h4M17 3h4v4M21 17v4h-4M7 21H3v-4"/></g><rect x="9" y="9" width="6" height="6" fill="currentColor"/></svg>
      <span class="neon">{prj}</span>
      <span>{kicker}</span>
      <span class="kline" aria-hidden="true"></span>
    </div>
    <h1 class="stencil rgb">{title}</h1>
    <p class="res">{result}</p>
    <dl class="facts">
      {facts.map((f) => (
        <div><dt>{f.k}</dt><dd>{f.led && <span class:list={['ndq-led', { on: active }]}></span>}{f.v}</dd></div>
      ))}
    </dl>
  </header>
  <figure class="hero">
    <div class="shot" role="img" aria-label="Placeholder: hero photo">[Hero photo: the finished build, worn or on a test rig]<div class="scan"></div></div>
  </figure>
</div>
<style>
  .band{display:flex;flex-wrap:wrap;gap:24px;align-items:stretch;padding-top:40px}
  .tb{flex:1 1 100%;display:flex;flex-direction:column;gap:16px;background:color-mix(in srgb,var(--bg) 45%,transparent);-webkit-backdrop-filter:blur(1px);backdrop-filter:blur(1px);--bw:1px;--bc:var(--panel-border);--cut:28px;padding:32px}
  .bc{font-family:var(--font-mono);font-size:14px;color:var(--text-muted);display:flex;align-items:center;gap:8px;min-height:44px;margin:-8px 0 0}
  .crumb{color:var(--accent);text-decoration:none;display:inline-flex;align-items:center;min-height:44px}
  .crumb:hover{text-decoration:underline}
  .kick{display:flex;flex-wrap:wrap;align-items:center;gap:14px;font-family:var(--font-mono);font-size:16px;letter-spacing:.26em;text-transform:uppercase;color:var(--accent)}
  .neon{background:var(--accent);color:var(--on-accent);padding:4px 8px 4px 11px}
  h1{margin:0;font-size:clamp(30px,6.5vw,84px);line-height:1;overflow-wrap:anywhere;font-weight:700}
  .res{margin:0;font-size:20px;line-height:30px;max-width:560px}
  .facts{margin:8px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));border:1px solid var(--panel-border);overflow:hidden}
  .facts div{padding:8px 16px;border-right:1px solid var(--panel-border);border-bottom:1px solid var(--panel-border);margin:0 -1px -1px 0}
  dt{font-family:var(--font-mono);font-size:14px;color:var(--text-muted)}
  dd{margin:4px 0 0;font-family:var(--font-mono);font-size:15px;line-height:22px}
  .hero{flex:1 1 100%;margin:0;padding:10px;background:var(--bezel);border:1px solid var(--trace);border-radius:2px}
  .shot{position:relative;aspect-ratio:3/2;background:var(--screen);display:flex;align-items:center;justify-content:center;text-align:center;padding:16px;font-family:var(--font-mono);font-size:14px;color:#B9B6C2}
</style>
